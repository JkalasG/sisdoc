NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Número de proxies de confianza delante del backend (Nginx = 1). Vacío = ninguno.
# Nº de proxies delante del backend (Nginx/Docker = 1). Vacío = ninguno: con proxy, TODAS las IP se verían como la del proxy
# y el límite de intentos de login y las IP de dispositivos serían las del proxy.
# En producción con Nginx: proxy_set_header X-Forwarded-For $remote_addr;  (SOBRESCRIBIR, no $proxy_add_x_forwarded_for,
# para que nadie pueda falsear su IP). Si hay Docker + Nginx del host, mira que el backend reciba la IP real y no 172.x.x.x.
TRUST_PROXY=

DATABASE_URL="postgresql://sisdoc:sisdoc_dev@localhost:5434/sisdoc?schema=public"
REDIS_URL=redis://localhost:6381

# Mínimo 32 caracteres, aleatorios. Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres-1

# Archivos en disco
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=50

# Zona horaria de la organización: define el año de "gestión" de los documentos
APP_TIMEZONE=America/La_Paz

# Editor en tiempo real (Contenedor OnlyOffice Document Server)
# URL pública desde la que el navegador carga el script api.js del editor
ONLYOFFICE_PUBLIC_URL=http://localhost:8082
# URL interna con la que el backend descarga el documento editado desde el contenedor OnlyOffice
ONLYOFFICE_INTERNAL_URL=http://localhost:8082
# Secreto compartido entre el contenedor OnlyOffice (JWT_SECRET) y este backend (mínimo 16 caracteres)
ONLYOFFICE_JWT_SECRET=sisdoc_onlyoffice_jwt_secret_2026_seguro
# URL con la que el contenedor de OnlyOffice alcanza a este backend para leer el archivo y enviar el callback
BACKEND_INTERNAL_URL=http://host.docker.internal:3000

# Dominios permitidos para crear usuarios desde el panel (separados por coma). Vacío = cualquier dominio.
ALLOWED_EMAIL_DOMAINS=

# ── Verificación en el inicio de sesión ───────────────────────────────────────
# Cada opción se enciende o apaga AQUÍ, en un solo lugar. El navegador consulta GET /auth/config, así que
# al apagarla desaparece de la pantalla de login y el servidor deja de exigirla. Reinicia el backend al cambiarlas.

# Captcha (Cloudflare Turnstile) en el login con contraseña. true = obligatorio; false = no se muestra ni se exige.
CAPTCHA_ENABLED=false
# Claves en https://dash.cloudflare.com/?to=/:account/turnstile (gratis). La "secret" NUNCA va al frontend.
# Para probar sin cuenta, Cloudflare publica claves de prueba: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA (siempre aprueban)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Acceso con Google. true = aparece el botón "Continuar con Google"; false = se oculta y el endpoint responde 403.
# Ver GOOGLE_AUTO_REGISTER más abajo para decidir si un correo desconocido se registra o se rechaza.
GOOGLE_LOGIN_ENABLED=false
# ID de cliente OAuth (tipo "Aplicación web") de Google Cloud Console. Orígenes autorizados: http://localhost:5173 y tu dominio.
GOOGLE_CLIENT_ID=
# Opcional: SOLO el dominio del correo (ej. empresa.com), nunca una URL. Exige cuentas de Google Workspace de ese dominio:
# un Gmail personal NO tiene dominio de empresa y quedaría rechazado. Vacío = cualquier cuenta de Google.
GOOGLE_ALLOWED_DOMAIN=
# Registro con Google: true = quien entra por primera vez con Google se REGISTRA y queda PENDIENTE: ve el aviso
# "tu cuenta no está activada, contacta a un administrador" y no entra hasta que un administrador la active (Usuarios → Activar).
# false = solo entran cuentas que un administrador ya creó. Recomendado: fija GOOGLE_ALLOWED_DOMAIN para que no se registre cualquiera.
GOOGLE_AUTO_REGISTER=true

# ── Correo (API de Gmail) y recuperación de contraseña ────────────────────────
# off   = el sistema no envía correos; "¿Olvidaste tu contraseña?" NO aparece en el login ni funciona.
# gmail = envía por la API de Gmail (necesita las 4 variables siguientes).
# log   = SOLO desarrollo: imprime el correo (con el código) en la consola del backend. Prohibido en producción.
MAIL_DRIVER=off
# Dirección desde la que se envía: debe ser LA MISMA cuenta que autorizó el refresh token.
MAIL_FROM=
MAIL_FROM_NAME=Iris
# Credenciales OAuth de Google Cloud con la API de Gmail habilitada (puede ser el mismo proyecto del acceso con Google).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Se obtiene UNA vez con:  npm run gmail:token   (ver instrucciones al ejecutarlo). Es un secreto: no lo compartas.
GMAIL_REFRESH_TOKEN=
