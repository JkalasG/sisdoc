# URL de la API (en desarrollo, Vite hace proxy de /api al backend: ver vite.config.ts)
VITE_API_URL=/api/v1

# MODO MOCK: "true" = la app NO usa la red; un backend simulado responde en memoria.
# Sirve para diseñar y demostrar la interfaz sin tener el backend levantado.
# En producción debe ser "false" (el build de producción rechaza arrancar con mocks).
VITE_USE_MOCKS=true
